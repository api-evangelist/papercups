  "info": {
    "_postman_id": "902abe07-8791-49ad-a697-ac6bed24d4ad",
    "name": "Papercups Conversations Messages API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API for Papercups, the open-source customer-messaging and live-chat platform built on Elixir/Phoenix. Covers the documented conversations, messages, and customers resources plus the authenticated user endpoint. Authentication uses a Bearer API key (available from the Papercups dashboard). The hosted instance is at https://app.papercups.io; self-hosted deployments expose the same paths on their own host. Papercups is in maintenance mode (community-maintained).\n\nContact Support:\n Name: Papercups",
      "type": "text/plain"
    }
  }
