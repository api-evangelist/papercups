{
  "opencollection": "1.0.0",
  "info": {
    "name": "Papercups Conversations Users API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve the authenticated user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.papercups.io/api/v1/me"
          },
          "docs": "Returns information about the user that owns the API key."
        }
      ]
    }
  ],
  "bundled": true
}